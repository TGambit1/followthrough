# Required for finalist eligibility: use your emailed Atlas Hackathon Sandbox.
MONGODB_URI=
MONGODB_DB=followthrough
# Optional model planner. Uses an OpenAI-compatible chat completions endpoint.
MODEL_API_KEY=
MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=
# Local deterministic preview is explicitly labeled when credentials are absent.

# Separate key for clients of /api/negotiations. Generate with npm run api:key.
NEGOTIATION_API_KEY=

# Authenticated hosted scheduler; generated locally, uploaded as a secret.
CRON_SECRET=
# Shared daily inference-call cap for the public car demo.
DEMO_MODEL_CALL_LIMIT=300
